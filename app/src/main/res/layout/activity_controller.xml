<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- Panel nhập mã -->
    <LinearLayout
        android:id="@+id/layout_code_entry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote Assist"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máy điều khiển"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="32dp" />

        <!-- Card kết nối lại server cũ -->
        <LinearLayout
            android:id="@+id/btn_last_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:background="#1E3A5F"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kết nối lại"
                android:textColor="#7EB8F7"
                android:textSize="12sp"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/text_last_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:text="------" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bấm để kết nối ngay"
                android:textColor="#7EB8F7"
                android:textSize="11sp"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- Divider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="─── hoặc nhập mã mới ───"
            android:textColor="#666666"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Nhập mã -->
        <EditText
            android:id="@+id/edit_pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="6"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:hint="Nhập mã 6 số"
            android:textSize="24sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.3"
            android:background="#333333"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kết nối"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- View màn hình remote -->
    <FrameLayout
        android:id="@+id/remote_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#000000">

        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="Ngắt" />

        <Button
            android:id="@+id/btn_toggle_keyboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="⌨"
            android:textSize="20sp"
            android:padding="0dp" />

        <LinearLayout
            android:id="@+id/layout_keyboard_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#DD000000"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_remote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gõ để gửi văn bản sang điện thoại"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:background="@android:color/transparent"
                android:paddingStart="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/btn_key_tab"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Tab" android:textSize="12sp" />
                <Button android:id="@+id/btn_key_backspace"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="⌫" android:textSize="16sp" />
                <Button android:id="@+id/btn_key_esc"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Esc" android:textSize="12sp" />
                <Button android:id="@+id/btn_key_enter"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="↵" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</FrameLayout>

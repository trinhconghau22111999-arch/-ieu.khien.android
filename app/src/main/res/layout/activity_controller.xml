<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- ── Panel nhập mã ── -->
    <LinearLayout
        android:id="@+id/layout_code_entry"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote Assist"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Máy điều khiển"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="32dp" />

        <!--
            NÚT MỚI: Kết nối lại server cũ.
            Ẩn mặc định, hiện khi prefs có "last_room_code".
        -->
        <androidx.cardview.widget.CardView
            android:id="@+id/btn_last_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:cardBackgroundColor="#1E3A5F"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kết nối lại"
                    android:textColor="#7EB8F7"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/text_last_code"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bấm để kết nối ngay"
                    android:textColor="#7EB8F7"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Divider "hoặc nhập mã mới" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#444444" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="  hoặc nhập mã mới  "
                android:textColor="#888888" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#444444" />
        </LinearLayout>

        <!-- Nhập mã tay -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#555555"
            android:hint="Mã 6 số">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_pairing_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:letterSpacing="0.3" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Kết nối"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- ── View màn hình remote (hiện sau khi kết nối) ── -->
    <FrameLayout
        android:id="@+id/remote_view_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:background="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- WebRTC video renderer -->
        <org.webrtc.SurfaceViewRenderer
            android:id="@+id/surface_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút ngắt kết nối (góc trên phải) -->
        <Button
            android:id="@+id/btn_disconnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:text="Ngắt"
            android:alpha="0.80"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Nút bàn phím ảo (góc dưới phải) -->
        <Button
            android:id="@+id/btn_toggle_keyboard"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="12dp"
            android:text="⌨"
            android:textSize="20sp"
            android:padding="0dp"
            android:alpha="0.80"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <!-- Keyboard bar (ẩn mặc định) -->
        <LinearLayout
            android:id="@+id/layout_keyboard_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#DD000000"
            android:padding="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/edit_remote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gõ để gửi văn bản sang điện thoại"
                android:textColor="#FFFFFF"
                android:textColorHint="#AAAAAA"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:background="@android:color/transparent"
                android:paddingStart="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button android:id="@+id/btn_key_tab"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Tab" android:textSize="12sp" />
                <Button android:id="@+id/btn_key_backspace"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="⌫" android:textSize="16sp" />
                <Button android:id="@+id/btn_key_esc"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="Esc" android:textSize="12sp" />
                <Button android:id="@+id/btn_key_enter"
                    android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:text="↵" android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

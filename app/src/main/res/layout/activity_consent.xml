<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Banner cảnh báo Accessibility -->
        <LinearLayout
            android:id="@+id/banner_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFF3CD"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cần bật Dịch vụ Hỗ trợ trước"
                android:textStyle="bold"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Vào Cài đặt › Hỗ trợ (Accessibility) › Remote Assist và bật lên."
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_open_accessibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mở Cài đặt Hỗ trợ" />
        </LinearLayout>

        <!-- Phần đồng ý (lần đầu) -->
        <LinearLayout
            android:id="@+id/layout_consent_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cho phép điều khiển từ xa"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Ứng dụng này sẽ:\n\n• Chia sẻ màn hình sang thiết bị bạn chọn\n• Truyền âm thanh hệ thống sang thiết bị đó\n• Cho phép thiết bị đó chạm điều khiển máy này\n\nMã 6 số được tạo một lần và lưu vĩnh viễn."
                android:textSize="15sp" />

            <CheckBox
                android:id="@+id/checkbox_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tôi đồng ý cho thiết bị khác điều khiển máy này" />

            <Button
                android:id="@+id/btn_generate_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="Tạo mã &amp; Bắt đầu chia sẻ" />
        </LinearLayout>

        <!-- Hiển thị mã (sau khi tạo) -->
        <LinearLayout
            android:id="@+id/layout_pairing_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mã ghép nối"
                android:textSize="14sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/text_pairing_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.3"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:text="------" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Chia sẻ mã này cho máy cần điều khiển"
                android:textSize="12sp"
                android:textColor="#888888"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_new_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tạo mã mới"
                android:visibility="gone" />

            <Button
                android:id="@+id/btn_end_session"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#D32F2F"
                android:text="Ngắt kết nối" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

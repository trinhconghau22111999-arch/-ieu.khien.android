<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        RECORD_AUDIO: bắt buộc để dùng AudioPlaybackCaptureConfiguration (Android 10+).
        Dùng để capture âm thanh HỆ THỐNG (tiếng app, nhạc, video) — KHÔNG phải mic.
        Người dùng phải tự cấp quyền này lần đầu.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher_background"
        android:roundIcon="@drawable/ic_launcher_background"
        android:supportsRtl="true"
        android:theme="@style/Theme.RemoteAssist">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Máy B: ConsentActivity.
            singleTop để ACTION_NEW_CODE từ service không tạo instance mới.
        -->
        <activity
            android:name=".ConsentActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            Máy A: ControllerActivity.
            configChanges để không mất kết nối WebRTC khi xoay màn hình.
        -->
        <activity
            android:name=".ControllerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!--
            RemoteHostService: foreground service với mediaProjection.
            Chạy liên tục hiển thị thông báo persistent với 2 nút hành động.
        -->
        <service
            android:name=".RemoteHostService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
            InputInjectionService: nhận lệnh tap/swipe và thực thi.
            Người dùng bật thủ công trong Cài đặt > Hỗ trợ.
        -->
        <service
            android:name=".InputInjectionService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
